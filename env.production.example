# ==========================================
# EnglishHub Production Environment Variables
# ==========================================
# Sao chép tệp này thành .env trên server triển khai (hoặc thư mục /opt/englishhub/.env):
# cp env.production.example .env

# --- Cấu hình Image Registry ---
BACKEND_IMAGE=...
FRONTEND_IMAGE=...

# --- Cổng dịch vụ ---
FRONTEND_PORT=...
BACKEND_PORT=...

# --- Cơ sở dữ liệu PostgreSQL ---
POSTGRES_DB=...
POSTGRES_USER=...
POSTGRES_PASSWORD=...

# --- Bảo mật & JWT ---
JWT_SECRET=...

# --- Tích hợp AI (AI Grading Engine) ---
OPENAI_API_KEY=...
