# ==============================================================================
# EnglishHub Production Environment Variables (.env)
# ==============================================================================
# Sao chép tệp này thành .env trên PC triển khai:
# cp env.production.example .env
# Dùng chung cho docker-compose.prod.yml và docker-compose.staging.yml
# ==============================================================================

# --- Cấu hình Docker Image & Port ---
BACKEND_IMAGE=ghcr.io/hotung9108/englishhub/backend:latest
BACKEND_PORT=8080
SERVER_PORT=8080
# --- Spring Boot proxy headers (bắt buộc khi chạy sau Cloudflare Tunnel / reverse proxy) ---
SERVER_FORWARD_HEADERS_STRATEGY=framework

# --- OpenAPI server URL (override theo môi trường staging/prod thực tế) ---
APP_OPENAPI_SERVER_URL=https://api.hotung9108.me
APP_OPENAPI_SERVER_DESCRIPTION=Production (Cloudflare Tunnel)

# --- Cơ sở dữ liệu Neon PostgreSQL (Serverless Cloud) ---
# Lấy từ Neon Dashboard -> Connection Details -> JDBC.
# QUAN TRỌNG: dùng host có hậu tố "-pooler" (Neon PgBouncer) để tránh phải mở
# kết nối TLS mới cho mỗi request. Kèm prepareThreshold=0 vì PgBouncer chạy ở
# transaction mode, server-side prepared statement không được đảm bảo tái sử dụng.
DB_URL=jdbc:postgresql://ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&prepareThreshold=0&tcpKeepAlive=true
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password_here

# --- Bảo mật & JWT Token (Tối thiểu 32 ký tự ngẫu nhiên) ---
JWT_SECRET=your-production-super-secret-jwt-key-minimum-32-chars

# --- CORS: danh sách domain frontend được phép gọi API (phân tách bởi dấu phẩy) ---
# QUAN TRỌNG (BUG-17): "*" = cho phép MỌI origin gửi request KÈM credentials (cookie/Authorization).
# Chỉ dùng "*" cho dev local. Khi chạy thật BẮT BUỘC khai báo domain cụ thể.
# Backend chỉ cho phép các origin khớp CHÍNH XÁC (hoặc pattern "https://*.hotung9108.me").
#
# Production (docker-compose.prod.yml) — dùng giá trị này:
CORS_ALLOWED_ORIGINS=https://hotung9108.me,https://app.hotung9108.me,https://api.hotung9108.me
# Staging (docker-compose.staging.yml) — override thành giá trị này:
# CORS_ALLOWED_ORIGINS=https://staging.hotung9108.me,https://api-staging.hotung9108.me
#
# Lưu ý: nếu biến bị xóa/để trống, backend FALLBACK về "*" và log WARNING khi khởi động —
# kiểm tra log "CORS allowed origins" sau mỗi lần deploy để xác nhận đúng cấu hình.

# --- Tích hợp AI (AI Grading Engine) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Tối ưu RAM cho JVM Spring Boot ---
JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m

# --- S3-compatible for production (AWS S3, Cloudflare R2, Neon Storage, ...) ---
STORAGE_S3_ENABLED=true
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_BUCKET=englishhub-dev
STORAGE_S3_PATH_STYLE=true

# --- AI Service connection (FastAPI Microservice) ---
# Biến cho BACKEND (docker-compose.prod.yml / docker-compose.staging.yml).
# AI service chạy ĐỘC LẬP bằng docker-compose.ai-service.yml và dùng file env
# riêng (ai-service/.env, xem env.ai-service.example) — không khai báo ở đây.
#
# Base URL backend dùng để gọi AI service.
# Mặc định http://ai-service:8001 = cùng network englishhub_shared (khuyến nghị)
# Nếu AI service chạy ở máy khác: http://<host-ai-service>:8001
AI_SERVICE_BASE_URL=http://ai-service:8001
INTERNAL_SECRET=
# Timeout kết nối (giây) giữa backend -> AI service
AI_SERVICE_CONNECT_TIMEOUT_SECONDS=5
# Timeout đọc phản hồi (giây) giữa backend -> AI service
AI_SERVICE_READ_TIMEOUT_SECONDS=60
# Model/provider backend gửi sang AI service (để trống = dùng mặc định của AI service)
AI_SERVICE_MODEL=
AI_SERVICE_PROVIDER=

# --- Outbound Email (EmailJS REST) — gửi OTP/mã đặt lại mật khẩu ---
# Map với app.email.* trong backend/src/main/resources/application.properties.
# BẮT BUỘC: bật "Allow non-browser applications" trong EmailJS Dashboard (Account -> Security)
#           thì backend mới gọi được API EmailJS (không có Origin trình duyệt).
# EMAILJS_PRIVATE_KEY là thông tin mật -> KHÔNG commit lên git.
# Nếu EMAIL_ENABLED=false (hoặc thiếu key), POST /auth/forgot-password sẽ báo lỗi
# (500 "Dịch vụ email chưa được cấu hình." / 502 khi gửi thất bại).
EMAIL_ENABLED=true
EMAILJS_BASE_URL=https://api.emailjs.com
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_PASSWORD_RESET_TEMPLATE_ID=your_password_reset_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_TIMEOUT_SECONDS=10
# Link đặt lại mật khẩu nhúng trong email — phải là domain frontend thật.
# Production: https://hotung9108.me/reset-password
# Staging   : https://staging.hotung9108.me/reset-password  (override khi chạy docker-compose.staging.yml)
FRONTEND_RESET_PASSWORD_URL=https://hotung9108.me/reset-password

