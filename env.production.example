# ==============================================================================
# EnglishHub Production Environment Variables (.env)
# ==============================================================================
# Sao chép tệp này thành .env trên PC triển khai:
# cp env.production.example .env
# ==============================================================================

# --- Cấu hình Docker Image & Port ---
BACKEND_IMAGE=ghcr.io/hotung9108/englishhub/backend:latest
BACKEND_PORT=8080
SERVER_PORT=8080

# --- Cơ sở dữ liệu Neon PostgreSQL (Serverless Cloud) ---
# Lấy từ Neon Dashboard -> Connection Details -> JDBC
DB_URL=jdbc:postgresql://ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password_here

# --- Bảo mật & JWT Token (Tối thiểu 32 ký tự ngẫu nhiên) ---
JWT_SECRET=your-production-super-secret-jwt-key-minimum-32-chars

# --- CORS: danh sách domain frontend được phép gọi API (phân tách bởi dấu phẩy) ---
# "*" = cho phép mọi origin. Nên thay bằng domain cụ thể khi chạy thật,
# ví dụ: https://englishhub.io,https://www.englishhub.io
CORS_ALLOWED_ORIGINS=*

# --- Tích hợp AI (AI Grading Engine) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Tối ưu RAM cho JVM Spring Boot ---
JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m

# --- S3-compatible for production (AWS S3, Cloudflare R2, Neon Storage, ...) ---
STORAGE_S3_ENABLED=true
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_BUCKET=englishhub-dev
STORAGE_S3_PATH_STYLE=true

# --- AI Microservice (FastAPI + OpenRouter / Gemini Multimodal) ---
AI_SERVICE_IMAGE=ghcr.io/hotung9108/englishhub/ai-service:latest
AI_SERVICE_PORT=8001
AI_SERVICE_BASE_URL=http://ai-service:8001
AI_PROVIDER=auto
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_SERVICE_MOCK_MODE=false
