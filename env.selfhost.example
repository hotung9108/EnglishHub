# =============================================================================
# FILE MẪU — env.selfhost.example (Dùng cho Self-Hosting trên PC cá nhân)
# =============================================================================
# Sao chép file này thành .env ở cùng thư mục trước khi chạy:
#   cp env.selfhost.example .env
#   docker compose -f docker-compose.selfhost.yml up -d --build
# =============================================================================

# --- Cổng Web truy cập trên PC (Mặc định 80 cho web chuẩn) ---
HTTP_PORT=80

# --- Cơ sở dữ liệu PostgreSQL ---
DB_NAME=englishhub_db
DB_USER=englishhub_admin
DB_PASSWORD=...
DB_PORT=5432

# --- Bảo mật JWT (Chuỗi bí mật ngẫu nhiên ít nhất 32 ký tự) ---
JWT_SECRET=...

# --- Tích hợp AI Chấm Điểm (OpenAI API Key) ---
OPENAI_API_KEY=...

# --- (Tùy chọn) Token Cloudflare Tunnel nếu muốn ra ngoài Internet ---
CLOUDFLARE_TUNNEL_TOKEN=...
