{
  "name": "englishhub-selenium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "reports:build": "node tools/build-report-index.js",
    "reports:export": "node tools/export-report.js",
    "test": "node run.js",
    "test:all": "node common/runner/run-batches.js",
    "test:admin": "node run.js --role=admin",
    "test:teacher": "node run.js --role=teacher",
    "test:student": "node run.js --role=student",
    "list": "node run.js --list",
    "find": "node tools/find-cases.js",
    "check": "node --test tests/*.test.js",
    "check:remake": "node --test tests/core.test.js tests/mapping-review.test.js tests/csv-evidence.test.js"
  },
  "dependencies": {
    "selenium-webdriver": "4.35.0"
  }
}
