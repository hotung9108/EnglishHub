SELENIUM_BASE_URL=https://staging.hotung9108.me
SELENIUM_BROWSER=chrome
SELENIUM_HEADLESS=true
SELENIUM_TIMEOUT_MS=30000
# Optional: explicit browser/driver executable, or Selenium Grid.
# SELENIUM_BROWSER_BINARY=C:/Program Files/Google/Chrome/Application/chrome.exe
# SELENIUM_DRIVER_PATH=D:/tools/chromedriver.exe
# SELENIUM_GRID_URL=http://localhost:4444
# test:roles uses all roles; QA29 also needs all roles for fixture preparation/cleanup.
# Use dedicated QA accounts.
SELENIUM_ADMIN_EMAIL=
SELENIUM_ADMIN_PASSWORD=
SELENIUM_TEACHER_EMAIL=
SELENIUM_TEACHER_PASSWORD=
SELENIUM_STUDENT_EMAIL=
SELENIUM_STUDENT_PASSWORD=

# QA-29 Teacher business flows (npm.cmd run test:teacher).
# Exact names of dedicated staging QA fixtures; quote names containing spaces.
QA29_CLASS_NAME=
QA29_STUDENT_NAME=
QA29_ASSIGNMENT_TITLE=
QA29_SCORE=7
# Explicit wait for assignment lists/gradebook data; not a fixed sleep.
QA29_DATA_TIMEOUT_MS=180000
# Second QA Teacher for outside-class permission tests; do not use the main teacher.
QA29_OUTSIDER_EMAIL=
QA29_OUTSIDER_PASSWORD=
