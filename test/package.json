{
  "name": "englishhub-tests",
  "version": "1.0.0",
  "description": "Comprehensive test suite for EnglishHub (dev & staging)",
  "type": "module",
  "scripts": {
    "reports:build": "npm --prefix selenium run reports:build",
    "find": "node scripts/find-tests.mjs",
    "selenium:check": "npm --prefix selenium run check",
    "selenium:list": "npm --prefix selenium run list",
    "api:list": "node api/catalog.js --list",
    "api:check": "node api/catalog.js --check",
    "test:env:check": "node scripts/check-env.js",
    "selenium:dev": "cross-env TEST_ENV=dev npm --prefix selenium test",
    "selenium:staging": "npm --prefix selenium test",
    "selenium:login": "npm --prefix selenium test -- LOGIN_001 LOGIN_002 LOGIN_003"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "chai": "^4.3.10",
    "chromedriver": "^120.0.0",
    "cross-env": "^7.0.3",
    "mocha": "^10.2.0",
    "selenium-webdriver": "^4.16.0"
  }
}
