{
  "name": "englishhub-tests",
  "version": "1.0.0",
  "description": "Comprehensive test suite for EnglishHub (dev & staging)",
  "type": "module",
  "scripts": {
    "test:env:check": "node scripts/check-env.js",
    "selenium:dev": "cross-env TEST_ENV=dev npm --prefix selenium test",
    "selenium:staging": "npm --prefix selenium test",
    "selenium:login": "npm --prefix selenium run test:login"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "chai": "^4.3.10",
    "chromedriver": "^120.0.0",
    "cross-env": "^7.0.3",
    "mocha": "^10.2.0",
    "selenium-webdriver": "^4.16.0"
  }
}
