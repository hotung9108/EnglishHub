# =============================================================================
# FILE MẪU — env.dev.example (Dùng cho Full-Stack docker-compose.dev.yml ở root)
# =============================================================================
# Sử dụng khi bạn muốn chạy Full-Stack (PostgreSQL + Backend + Frontend) bằng Docker:
#
#   cp env.dev.example .env
#   docker compose -f docker-compose.dev.yml up --build
# =============================================================================

# --- PostgreSQL Database ---
DB_USER=devuser
DB_PASSWORD=devpassword
DB_NAME=appdb
DB_PORT=5432

# --- Backend Service ---
BACKEND_PORT=8080
JWT_SECRET=englishhub-development-jwt-secret-key-32chars-min
# Danh sách domain frontend được phép gọi API (phân tách bởi dấu phẩy). "*" = cho phép tất cả.
CORS_ALLOWED_ORIGINS=*
OPENAI_API_KEY=

# --- MinIO (S3-compatible for local dev) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_S3_ENABLED=true
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=englishhub-dev
STORAGE_S3_PATH_STYLE=true
# Giới hạn kích thước file nộp bài tối đa của học viên (bytes) - Mặc định 10MB: 10 * 1024 * 1024 = 10485760
STORAGE_MAX_SUBMISSION_FILE_SIZE_BYTES=10485760

# --- Frontend Service ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- AI Microservice (FastAPI + OpenRouter / Gemini Multimodal) ---
AI_SERVICE_PORT=8001
AI_SERVICE_BASE_URL=http://localhost:8001
INTERNAL_SECRET=
AI_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_SERVICE_MOCK_MODE=false

# --- Outbound Email (EmailJS REST) — gửi OTP/mã đặt lại mật khẩu ---
# Bắt buộc bật "Allow non-browser applications" trong EmailJS Dashboard (Account -> Security)
# để backend gọi được API EmailJS. EMAILJS_PRIVATE_KEY là thông tin mật, KHÔNG commit.
# Nếu EMAIL_ENABLED=false (hoặc thiếu key), POST /auth/forgot-password sẽ báo lỗi
# (500 "Dịch vụ email chưa được cấu hình." / 502 khi gửi thất bại).
EMAIL_ENABLED=true
EMAILJS_BASE_URL=https://api.emailjs.com
EMAILJS_SERVICE_ID=
EMAILJS_PASSWORD_RESET_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_TIMEOUT_SECONDS=10
# Link đặt lại mật khẩu nhúng trong email — trỏ tới trang /reset-password của frontend.
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password

# --- Khởi tạo tài khoản hệ thống mặc định (Automatic Bootstrap Seed Accounts) ---
# Tự động nạp tài khoản 1 lần duy nhất khi khởi tạo database trắng.
# Ở dev/staging: tạo 3 tài khoản Admin, Teacher, Student (theo Mục 6 README.md).
# APP_DEFAULT_ACCOUNTS_ENABLED=true
# APP_SEED_INCLUDE_DEMO_ACCOUNTS=true
APP_INIT_ADMIN_EMAIL=admin@englishhub.com
APP_INIT_ADMIN_PASSWORD=Password123!
APP_INIT_ADMIN_NAME="Admin EnglishHub"

APP_INIT_TEACHER_EMAIL=teacher@englishhub.com
APP_INIT_TEACHER_PASSWORD=Password123!
APP_INIT_TEACHER_NAME="Teacher EnglishHub"
APP_INIT_TEACHER_SPECIALIZATION="Tiếng Anh giao tiếp & Luyện thi"

APP_INIT_STUDENT_EMAIL=student@englishhub.com
APP_INIT_STUDENT_PASSWORD=Password123!
APP_INIT_STUDENT_NAME="Student EnglishHub"
APP_INIT_STUDENT_CODE=SV999999



