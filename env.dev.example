# =============================================================================
# FILE MẪU — env.dev.example (Dùng cho Full-Stack docker-compose.dev.yml ở root)
# =============================================================================
# Sử dụng khi bạn muốn chạy Full-Stack (PostgreSQL + Backend + Frontend) bằng Docker:
#
#   cp env.dev.example .env
#   docker compose -f docker-compose.dev.yml up --build
# =============================================================================

# --- PostgreSQL Database ---
DB_USER=devuser
DB_PASSWORD=devpassword
DB_NAME=appdb
DB_PORT=5432

# --- Backend Service ---
BACKEND_PORT=8080
JWT_SECRET=englishhub-development-jwt-secret-key-32chars-min
OPENAI_API_KEY=

# --- Frontend Service ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
