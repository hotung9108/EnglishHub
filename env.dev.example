# =============================================================================
# FILE MẪU — env.dev.example (Dùng cho Full-Stack docker-compose.dev.yml ở root)
# =============================================================================
# Sử dụng khi bạn muốn chạy Full-Stack (PostgreSQL + Backend + Frontend) bằng Docker:
#
#   cp env.dev.example .env
#   docker compose -f docker-compose.dev.yml up --build
# =============================================================================

# --- PostgreSQL Database ---
DB_USER=devuser
DB_PASSWORD=devpassword
DB_NAME=appdb
DB_PORT=5432

# --- Backend Service ---
BACKEND_PORT=8080
JWT_SECRET=englishhub-development-jwt-secret-key-32chars-min
OPENAI_API_KEY=

# --- MinIO (S3-compatible for local dev) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_S3_ENABLED=true
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=englishhub-dev
STORAGE_S3_PATH_STYLE=true

# --- Frontend Service ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
