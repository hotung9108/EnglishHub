# =============================================================================
# FILE MẪU — env.docker_compose.example
# =============================================================================
# Mục đích : Khai báo các biến môi trường cho docker-compose.dev.yml
#            (dùng để khởi động PostgreSQL local).
#
# Để sử dụng : Tạo file .env nằm CÙNG CẤP với file này (ở root dự án),
#              sao chép nội dung bên dưới rồi điền giá trị thật.
#
#   cp env.docker_compose.example .env
#
# Lưu ý    : File .env đã được thêm vào .gitignore — KHÔNG commit file .env
#            chứa giá trị thật lên repo.
#            Nếu không tạo file .env, docker-compose sẽ dùng giá trị mặc
#            định ghi trong docker-compose.dev.yml (xem phần :-<default>).
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL — thông tin kết nối database dev
# ---------------------------------------------------------------------------

# Tên user đăng nhập vào PostgreSQL
DB_USER=devuser

# Mật khẩu của user trên (đặt mật khẩu đủ mạnh nếu expose ra ngoài localhost)
DB_PASSWORD=devpassword

# Tên database sẽ được tạo tự động khi container khởi động lần đầu
DB_NAME=appdb

# Port PostgreSQL expose ra máy host (mặc định 5432)
# Đổi sang port khác (vd: 5433) nếu máy đã có PostgreSQL chiếm 5432
DB_PORT=5432
