# =============================================================================
# FILE MẪU — env.ai-service.example (Env file RIÊNG của AI Microservice)
# =============================================================================
# AI service không dùng .env ở root (của backend/prod/staging) mà dùng env file riêng.
#
#   cp env.ai-service.example ai-service/.env
#   docker compose --env-file ai-service/.env -f docker-compose.ai-service.yml up -d --build
#
# Bắt buộc: điền ít nhất một API key (OPENROUTER_API_KEY hoặc GEMINI_API_KEY),
# hoặc đặt AI_SERVICE_MOCK_MODE=true để chạy offline (benchmark QA-21).
# =============================================================================

# --- Docker Image & Port ---
# Image name (tự build local hoặc pull từ registry)
AI_SERVICE_IMAGE=englishhub-ai-service:latest
# Cổng expose ra host
AI_SERVICE_PORT=8001

# --- CORS: danh sách domain frontend được phép gọi API (phân tách bởi dấu phẩy) ---
# "*" = cho phép mọi origin. Nên giới hạn khi chạy thật, ví dụ: https://englishhub.io
CORS_ALLOWED_ORIGINS=*

# --- Chiến lược chọn AI provider: "auto" | "openrouter" | "gemini" ---
# "auto": ưu tiên OpenRouter, fallback Gemini nếu không có key
AI_PROVIDER=auto

# --- OpenRouter (Unified multi-model API) ---
# Lấy key tại https://openrouter.ai/keys (bắt đầu bằng sk-or-v1-...)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Google Gemini Direct (fallback tùy chọn) ---
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Mock / Benchmark Mode ---
# true = chạy offline với QA-21 fixed benchmark, không gọi API thật (dùng cho CI/test)
AI_SERVICE_MOCK_MODE=false

# --- Timeout & Retries ---
AI_SERVICE_REQUEST_TIMEOUT_SECONDS=60
AI_SERVICE_MAX_RETRIES=2
