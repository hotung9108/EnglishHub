# ==============================================================================
# EnglishHub AI Service - Local Environment Variables (.env)
# ==============================================================================

# Cổng chạy FastAPI
PORT=8001

# Chiến lược chọn AI provider: "auto", "openrouter", "gemini"
AI_PROVIDER=openrouter

# OpenRouter API Key (bắt đầu bằng sk-or-v1-...)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# Google Gemini Direct (Tùy chọn fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Mock / Benchmark Mode (True để chạy offline với QA-21 fixed benchmark)
MOCK_MODE=false

# Timeout & Retries
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=2
