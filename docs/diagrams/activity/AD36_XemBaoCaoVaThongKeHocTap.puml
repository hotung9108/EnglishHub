@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ActivityBorderColor #2C3E50
skinparam ActivityBackgroundColor #F8F9FA
skinparam ActivityDiamondBorderColor #2C3E50
skinparam ActivityDiamondBackgroundColor #EBF5FB
skinparam ArrowColor #2C3E50
skinparam ArrowFontSize 11
skinparam SwimlaneBorderColor #7F8C8D
skinparam SwimlaneTitleFontSize 13
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneTitleBackgroundColor #EAEDED
skinparam roundCorner 14
skinparam dpi 250
skinparam shadowing false

|Người dùng (Admin / Giáo viên)|
start
:Đăng nhập và truy cập phân hệ "Báo cáo & Thống kê";

|Hệ thống|
:Hiển thị giao diện báo cáo tổng quan và bộ lọc tiêu chí;

|Người dùng (Admin / Giáo viên)|
:Thiết lập bộ lọc dữ liệu thống kê:\n- Lọc theo khóa học/lớp/giáo viên\n- Lọc theo khoảng thời gian (Từ ngày - Đến ngày);
:Nhấn nút "Tạo báo cáo / Thống kê";

|Hệ thống|
:Truy vấn CSDL và tổng hợp các chỉ số học tập:\n- Tỷ lệ hoàn thành bài tập\n- Điểm trung bình theo 4 kỹ năng (Nghe, Nói, Đọc, Viết)\n- Danh sách học viên cần chú ý cải thiện kết quả;
:Render biểu đồ trực quan hóa số liệu và bảng thống kê chi tiết;

|Người dùng (Admin / Giáo viên)|
:Xem xét và phân tích các chỉ số học tập trên giao diện;
if (Nhu cầu xuất báo cáo?) then (Có)
  :Chọn định dạng xuất dữ liệu (Excel .xlsx hoặc PDF);
  |Hệ thống|
  :Sinh tệp báo cáo tổng hợp theo mẫu định dạng chuẩn;
  :Cung cấp liên kết tải xuống an toàn cho người dùng;
  |Người dùng (Admin / Giáo viên)|
  :Tải tệp báo cáo thống kê về máy tính;
else (Không)
  :Hoàn tất tra cứu thông tin thống kê trực tuyến;
endif

stop
@enduml
