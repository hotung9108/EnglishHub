[Unit]
Description=EnglishHub - kiem tra & deploy backend/ai-service khi khoi dong server
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Doi ten user cho dung voi SERVER_USER da cau hinh trong startup-deploy.sh
User=REPLACE_WITH_SERVER_USER
ExecStart=/home/REPLACE_WITH_SERVER_USER/scripts/startup-deploy.sh
TimeoutStartSec=600
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
