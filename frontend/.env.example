# =============================================================================
# EnglishHub Frontend Environment Configuration Template (.env.example)
# =============================================================================
# Sao chép file này thành .env trong thư mục frontend/ và chỉnh sửa phù hợp:
#   cp .env.example .env
# =============================================================================

# API Gateway / Backend Base URL (Trỏ tới backend local hoặc gateway)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Network & Request Timeouts (in milliseconds)
VITE_API_TIMEOUT=20000
VITE_AUTH_REFRESH_TIMEOUT=10000

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Default Fallback Language (vi | en)
VITE_DEFAULT_LANGUAGE=vi

# =============================================================================
# API Endpoints Configuration
# =============================================================================
VITE_ENDPOINT_AUTH_BASE=/auth
VITE_ENDPOINT_AUTH_LOGIN=/auth/login
VITE_ENDPOINT_AUTH_REFRESH=/auth/refresh
VITE_ENDPOINT_AUTH_LOGOUT=/auth/logout
VITE_ENDPOINT_AUTH_REGISTER=/auth/register

VITE_ENDPOINT_USERS_BASE=/users
VITE_ENDPOINT_USERS_ME=/users/me
VITE_ENDPOINT_USERS_PROFILE=/users/me/profile
VITE_ENDPOINT_USERS_PASSWORD=/users/me/change-password

VITE_ENDPOINT_CLASSES_BASE=/classes
VITE_ENDPOINT_ASSIGNMENTS_BASE=/assignments