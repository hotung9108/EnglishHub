# =============================================================================
# FILE MẪU — env.frontend.example
# =============================================================================
# Mục đích : Khai báo các biến môi trường cho Frontend (Vite/React).
#
# Để sử dụng : Tạo file .env nằm CÙNG CẤP với file này (trong thư mục
#              frontend/), sao chép nội dung bên dưới rồi điền giá trị thật.
#
#   cp env.frontend.example .env
#
# Lưu ý    : File .env đã được thêm vào .gitignore — KHÔNG commit file .env
#            chứa giá trị thật lên repo.
# =============================================================================

# URL gốc của Backend API (trỏ tới BE đang chạy local)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Thời gian chờ request (milliseconds)
VITE_API_TIMEOUT=20000
VITE_AUTH_REFRESH_TIMEOUT=10000

# Tên môi trường — dùng để hiển thị / debug nếu cần (dev | staging | production)
VITE_APP_ENV=development

# Ngôn ngữ mặc định (vi | en)
VITE_DEFAULT_LANGUAGE=vi

# Cấu hình các Endpoint API
VITE_ENDPOINT_AUTH_BASE=/auth
VITE_ENDPOINT_AUTH_LOGIN=/auth/login
VITE_ENDPOINT_AUTH_REFRESH=/auth/refresh
VITE_ENDPOINT_AUTH_LOGOUT=/auth/logout
VITE_ENDPOINT_AUTH_REGISTER=/auth/register

VITE_ENDPOINT_USERS_BASE=/users
VITE_ENDPOINT_USERS_ME=/users/me
VITE_ENDPOINT_USERS_PROFILE=/users/me/profile
VITE_ENDPOINT_USERS_PASSWORD=/users/me/change-password

VITE_ENDPOINT_CLASSES_BASE=/classes
VITE_ENDPOINT_ASSIGNMENTS_BASE=/assignments
