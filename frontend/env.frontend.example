# =============================================================================
# FILE MẪU — env.frontend.example
# =============================================================================
# Mục đích : Khai báo các biến môi trường cho Frontend (Vite/React).
#
# Để sử dụng : Tạo file .env nằm CÙNG CẤP với file này (trong thư mục
#              frontend/), sao chép nội dung bên dưới rồi điền giá trị thật.
#
#   cp env.frontend.example .env
#
# Lưu ý    : File .env đã được thêm vào .gitignore — KHÔNG commit file .env
#            chứa giá trị thật lên repo.
# =============================================================================

# URL gốc của Backend API (trỏ tới BE đang chạy local)
VITE_API_BASE_URL=http://localhost:8080/api

# Tên môi trường — dùng để hiển thị / debug nếu cần (dev | staging | production)
VITE_APP_ENV=development
